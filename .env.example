# Optional LLM summary. DeepSeek uses the OpenAI-compatible chat API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Optional server settings.
PORT=4173
REQUEST_TIMEOUT_MS=15000

